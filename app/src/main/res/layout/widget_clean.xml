<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widgetCleanAction"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_space" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="bottom"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widgetSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="92.9"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widgetSizeUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp"
                android:includeFontPadding="false"
                android:text="GB"
                android:textColor="@color/accent_primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_status_storage"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/widgetLargeAction"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_card"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_files" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/widget_action_files"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widgetScreenshotAction"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_card"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_photo" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/widget_action_photos"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
