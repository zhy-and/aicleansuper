<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <View android:id="@+id/scrimView" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="#99000000"
        android:clickable="true" android:focusable="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:background="@drawable/bg_storage_permission_panel"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="26dp"
        android:paddingEnd="20dp" android:paddingBottom="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="84dp"
            android:background="@drawable/bg_storage_permission_row"
            android:gravity="center_vertical" android:paddingHorizontal="18dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp"
                android:src="@mipmap/ic_launcher" android:contentDescription="@null" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_weight="1"
                android:ellipsize="end" android:maxLines="1" android:text="@string/app_name"
                android:textColor="@color/text_primary" android:textSize="18sp"
                android:textStyle="bold" />
            <FrameLayout android:layout_width="60dp" android:layout_height="34dp"
                android:background="@drawable/bg_storage_permission_toggle_track">
                <View android:id="@+id/toggleThumb" android:layout_width="26dp"
                    android:layout_height="26dp" android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_storage_permission_toggle_thumb" />
            </FrameLayout>
        </LinearLayout>
        <TextView android:id="@+id/permissionGuideMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:gravity="center"
            android:text="@string/storage_permission_guide_message"
            android:textColor="@color/text_secondary" android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
