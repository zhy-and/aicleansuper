<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_premium_pill"
                android:drawableStart="@drawable/ic_crown"
                android:drawablePadding="6dp"
                android:drawableTint="@color/gold_text"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/premium"
                android:textColor="@color/gold_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_primary" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permissionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke_light"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="22dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/bg_glow_center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="168dp"
                            android:layout_height="168dp">

                            <com.example.cleansuperai.widget.CircularScanView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:csvIndeterminate="true"
                                app:csvStrokeWidth="10dp" />

                            <FrameLayout
                                android:layout_width="98dp"
                                android:layout_height="98dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_icon_container">

                                <ImageView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_clean"
                                    app:tint="@color/accent_primary" />
                            </FrameLayout>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:text="@string/permission_home_title"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnPermission"
                            style="@style/Widget.Cleansuperai.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/grant_access" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke_light"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="24dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@drawable/bg_glow_center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:minHeight="420dp"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="196dp"
                            android:layout_height="196dp">

                            <com.example.cleansuperai.widget.CircularScanView
                                android:id="@+id/scanRing"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:csvIndeterminate="true"
                                app:csvStrokeWidth="12dp" />

                            <TextView
                                android:id="@+id/tvScanPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/accent_primary"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvScanStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvScanSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:gravity="center"
                            android:text="@string/home_secure_analysis"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvReclaimValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/em_dash"
                            android:textColor="@color/accent_primary"
                            android:textSize="44sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progressScan"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="16dp"
                            android:indeterminateTint="@color/accent_secondary"
                            android:progressBackgroundTint="@color/surface_dark_secondary"
                            android:progressTint="@color/accent_primary"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnQuickClean"
                            style="@style/Widget.Cleansuperai.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:text="@string/home_quick_clean_action" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/home_quick_tools"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardSimilarPhotos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardDuplicatePhotos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardScreenshots"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardDuplicateVideos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardAllVideos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardSwipePhotos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
