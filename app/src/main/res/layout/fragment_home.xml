<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_premium_pill"
                android:drawableStart="@drawable/ic_crown"
                android:drawablePadding="6dp"
                android:drawableTint="@color/gold_text"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/premium"
                android:textColor="@color/gold_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_primary" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_hero"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:text="@string/home_cleanup_badge"
                            android:textColor="@color/accent_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/home_cleanup_library"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_quick_summary_body"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="92dp"
                        android:layout_height="88dp"
                        android:layout_marginStart="12dp">

                        <View
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_home_art_orange" />

                        <View
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="bottom|start"
                            android:background="@drawable/bg_home_art_blue" />

                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_home_art_pink" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/permissionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke_light"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="26dp"
                    android:paddingBottom="24dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:background="@drawable/bg_glow_center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="164dp"
                            android:layout_height="164dp">

                            <com.aetherquorion.cleansuperai.widget.CircularScanView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:csvIndeterminate="true"
                                app:csvStrokeWidth="10dp" />

                            <FrameLayout
                                android:layout_width="98dp"
                                android:layout_height="98dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_icon_container">

                                <ImageView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_clean"
                                    app:tint="@color/accent_primary" />
                            </FrameLayout>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:text="@string/permission_home_title"
                            android:textColor="@color/text_primary"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="@string/permission_home_body"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnPermission"
                            style="@style/Widget.Cleansuperai.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/grant_access" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke_light"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="136dp"
                        android:background="@drawable/bg_glow_center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:text="@string/home_cleanup_badge"
                            android:textColor="@color/accent_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScanStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingEnd="10dp">

                                <TextView
                                    android:id="@+id/tvReclaimValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/em_dash"
                                    android:textColor="@color/accent_primary"
                                    android:textSize="34sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvScanSummary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:maxLines="2"
                                    android:text="@string/home_secure_analysis"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp" />

                                <ProgressBar
                                    android:id="@+id/progressScan"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:layout_marginTop="12dp"
                                    android:indeterminateTint="@color/accent_secondary"
                                    android:progressBackgroundTint="@color/surface_dark_secondary"
                                    android:progressTint="@color/accent_primary"
                                    android:visibility="gone" />

                                <Button
                                    android:id="@+id/btnQuickClean"
                                    style="@style/Widget.Cleansuperai.Button.Primary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:minWidth="0dp"
                                    android:minHeight="42dp"
                                    android:paddingHorizontal="16dp"
                                    android:text="@string/home_quick_clean_compact_action"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="118dp"
                                android:layout_height="118dp"
                                android:layout_marginStart="2dp">

                                <View
                                    android:layout_width="82dp"
                                    android:layout_height="82dp"
                                    android:layout_gravity="center"
                                    android:alpha="0.9"
                                    android:background="@drawable/bg_glow_center" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_scan_ring_backplate" />

                                <com.aetherquorion.cleansuperai.widget.CircularScanView
                                    android:id="@+id/scanRing"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:csvIndeterminate="true"
                                    app:csvStrokeWidth="9dp" />

                                <TextView
                                    android:id="@+id/tvScanPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:textColor="@color/accent_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/home_quick_tools"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardSimilarPhotos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardDuplicatePhotos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardScreenshots"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardDuplicateVideos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardAllVideos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardSwipePhotos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
