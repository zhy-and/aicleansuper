<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_premium_pill"
                android:drawableStart="@drawable/ic_crown"
                android:drawablePadding="6dp"
                android:drawableTint="@color/gold_text"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/premium"
                android:textColor="@color/gold_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_primary" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeNotificationTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_permission_tip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_home_tip_icon"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_notifications"
                app:tint="@color/accent_primary" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="@string/home_tip_notification"
                android:textColor="#302929"
                android:textSize="12sp" />
            <FrameLayout
                android:layout_width="58dp"
                android:layout_height="27dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/bg_notif_cta_clip"
                android:clipToOutline="true"
                android:outlineProvider="background">
                <ProgressBar
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/anim_notif_cta_scale_green"
                    android:indeterminateOnly="true" />
                <TextView
                    android:id="@+id/homeNotificationTipButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/home_tip_notification_action"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeWidgetTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_home_permission_tip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_home_tip_icon"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_grid"
                app:tint="@color/accent_primary" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="@string/home_tip_widget"
                android:textColor="#302929"
                android:textSize="12sp" />
            <FrameLayout
                android:layout_width="58dp"
                android:layout_height="27dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/bg_notif_cta_clip"
                android:clipToOutline="true"
                android:outlineProvider="background">
                <ProgressBar
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/anim_notif_cta_scale_green"
                    android:indeterminateOnly="true" />
                <TextView
                    android:id="@+id/homeWidgetTipButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/home_tip_widget_action"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeAllFilesTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_home_permission_tip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_home_tip_icon"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_storage_permission_check"
                app:tint="@color/accent_primary" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="@string/home_tip_all_files"
                android:textColor="#302929"
                android:textSize="12sp" />
            <FrameLayout
                android:layout_width="58dp"
                android:layout_height="27dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/bg_notif_cta_clip"
                android:clipToOutline="true"
                android:outlineProvider="background">
                <ProgressBar
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/anim_notif_cta_scale_green"
                    android:indeterminateOnly="true" />
                <TextView
                    android:id="@+id/homeAllFilesTipButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/home_tip_all_files_action"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/inlineAdContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone" />


        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiDriven"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/home_scan_green"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke_light"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="136dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_home_scan_badge"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:text="@string/home_cleanup_badge"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScanStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingEnd="2dp">

                                <TextView
                                    android:id="@+id/tvReclaimValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/em_dash"
                                    android:textColor="@color/white"
                                    android:textSize="34sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvScanSummary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:maxLines="2"
                                    android:text="@string/home_secure_analysis"
                                    android:textColor="@color/white"
                                    android:textSize="13sp" />

                                <ProgressBar
                                    android:id="@+id/progressScan"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:layout_marginTop="12dp"
                                    android:indeterminateTint="@color/white"
                                    android:progressBackgroundTint="@color/home_scan_track"
                                    android:progressTint="@color/white"
                                    android:visibility="gone" />

                                <Button
                                    android:id="@+id/btnQuickClean"
                                    style="@style/Widget.Cleansuperai.Button.Primary"
                                    app:backgroundTint="@color/white"
                                    android:textColor="@color/accent_primary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginEnd="28dp"
                                    android:minWidth="0dp"
                                    android:minHeight="42dp"
                                    android:paddingHorizontal="8dp"
                                    app:icon="@drawable/ic_home_clean_arrow"
                                    app:iconGravity="textEnd"
                                    app:iconPadding="4dp"
                                    app:iconSize="14dp"
                                    app:iconTint="@color/accent_primary"
                                    android:singleLine="true"
                                    android:ellipsize="end"
                                    android:text="@string/home_quick_clean_compact_action"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="108dp"
                                android:layout_height="108dp"
                                android:layout_marginStart="2dp">

                                <View
                                    android:layout_width="82dp"
                                    android:layout_height="82dp"
                                    android:layout_gravity="center"
                                    android:alpha="0.9"
                                    android:visibility="gone" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:visibility="gone" />

                                <com.aetherquorion.cleansuperai.widget.CircularScanView
                                    android:id="@+id/scanRing"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:csvIndeterminate="true"
                                    app:csvStartColor="@color/white"
                                    app:csvEndColor="@color/home_scan_secondary"
                                    app:csvTrackColor="@color/home_scan_track"
                                    app:csvStrokeWidth="9dp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/tvScanPercent"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/white"
                                        android:textSize="25sp"
                                        android:textStyle="bold"
                                        android:visibility="gone" />
                                    <TextView
                                        android:id="@+id/tvStorageLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/widget_status_storage"
                                        android:textColor="@color/white"
                                        android:textSize="11sp"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/home_quick_tools"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardSimilarPhotos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardDuplicatePhotos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardScreenshots"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardDuplicateVideos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <include
                    android:id="@+id/cardAllVideos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1" />
                <include
                    android:id="@+id/cardSwipePhotos"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/home_more_tools"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <include
                    android:id="@+id/cardBatteryInfo"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1" />
                <include
                    android:id="@+id/cardDeviceInfo"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1" />
                <include
                    android:id="@+id/cardLargeFiles"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <include
                    android:id="@+id/cardCacheCleanup"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1" />
                <include
                    android:id="@+id/cardNetworkTraffic"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1" />
                <include
                    android:id="@+id/cardVault"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <include
                    android:id="@+id/cardPictureCleanup"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1" />
                <include
                    android:id="@+id/cardVideoCleanup"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1" />
                <include
                    android:id="@+id/cardAudioCleanup"
                    layout="@layout/view_home_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
